# ============================================================
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，绝不入库。
# ============================================================

# ---------- 应用 ----------
APP_NAME=电商知识库 RAG 问答系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api

# ---------- 安全 ----------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=请替换为随机字符串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 初始管理员（首次启动时若不存在则创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ---------- 阿里云百炼 (DashScope) ----------
# 控制台 API-KEY 页面获取。注意本工作空间的 Key 形如 sk-ws-<分段>.<分段>.<DER签名>
DASHSCOPE_API_KEY=sk-ws-xxxxxxxx
# OpenAI 兼容网关：chat / embeddings
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 原生网关：rerank（兼容端点没有 /rerank，实测 404）
DASHSCOPE_NATIVE_URL=https://dashscope.aliyuncs.com/api/v1

# ---------- 模型 ----------
LLM_MODEL=qwen3.7-plus
# qwen3.7-plus 是思考模型，默认返回 reasoning_content。
# 实测请求体加 enable_thinking:false 可关闭，显著降低首 token 时延。
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024
# check_api.py 二分实测：20 条可用，21 条起失败。留余量用 16。
# 换模型后请重跑 check_api.py 复核——这个值随模型变化。
EMBED_BATCH_SIZE=16

RERANK_MODEL=qwen3.7-text-rerank
RERANK_ENABLED=true
RERANK_TOP_N=5

# ---------- Provider 后端 ----------
# dashscope | local
EMBED_BACKEND=dashscope
# dashscope | local | none
RERANK_BACKEND=dashscope
# dashscope | mock  —— mock 用于无网络/无额度时开发全链路
LLM_BACKEND=dashscope

# ---------- 检索 ----------
CHUNK_SIZE=640
CHUNK_OVERLAP=96
RETRIEVE_TOP_K=20
RRF_K=60
# 重排后的相关性下限，低于此值丢弃。0.5 是扫出来的：第一个让跑题问题全部
# 拒答的阈值，同时离观测到的最差相关段落（0.7837）留了 0.28 余量。
# 0.0 = 不过滤。完整扫描表与取舍理由见 docs/RERANK-THRESHOLD.md
RERANK_SCORE_THRESHOLD=0.5
# 上下文 token 预算（自行估算，不用 trim_messages——ChatOpenAI 对 qwen 未实现 token 计数）
CONTEXT_TOKEN_BUDGET=3000

# ---------- 存储 ----------
DATA_DIR=data
DATABASE_URL=sqlite:///data/app.db
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
CHROMA_COLLECTION=rag_chunks
MAX_UPLOAD_MB=50

# ---------- 缓存 ----------
CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=600
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ---------- 限流 ----------
RATE_LIMIT_QPM=30
